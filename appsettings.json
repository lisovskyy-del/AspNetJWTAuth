{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "JwtSettings": {
    "SecretKey": "SuperSecretKeyForJwtTokenGenerationAtLeast32CharsLong!",
    "Issuer": "AspNetJWTAuth",
    "Audience": "AspNetJWTAuth.Users",
    "AccessTokenExpirationMinutes": 2,
    "RefreshTokenExpirationDays": 7
  }
}
